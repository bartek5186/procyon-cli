{
  "name": "procyon-cli",
  "version": "0.7.2",
  "description": "Command-line tools for creating and maintaining Procyon Go backends",
  "keywords": [
    "procyon",
    "go",
    "backend",
    "cli"
  ],
  "homepage": "https://github.com/bartek5186/procyon-cli#readme",
  "bugs": {
    "url": "https://github.com/bartek5186/procyon-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartek5186/procyon-cli.git"
  },
  "bin": {
    "procyon-cli": "npm/bin/procyon-cli.js"
  },
  "files": [
